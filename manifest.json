{
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "version": "0.1.38",
  "manifest_version": 3,
  "minimum_chrome_version": "109",
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://github.com/shelus2021/web-media-assistant-edge",
  "default_locale": "zh_CN",
  "incognito": "split",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "downloads",
    "clipboardWrite",
    "alarms",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "__MSG_browserActionTitle__",
    "default_icon": { "19": "icons/icon19.png", "38": "icons/icon38.png", "48": "icons/icon48.png" },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "match_about_blank": true,
      "css": ["inject.css"],
      "js": ["js/i18n.js", "js/defaults.js", "inject.js"]
    },
    {
      "all_frames": true,
      "matches": ["<all_urls>"],
      "match_about_blank": true,
      "run_at": "document_start",
      "js": ["imagus/includes/app.js"]
    },
    {
      "all_frames": true,
      "matches": ["<all_urls>"],
      "match_about_blank": true,
      "run_at": "document_end",
      "js": ["imagus/includes/rule-functions.js", "imagus/includes/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.css", "shadow.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
